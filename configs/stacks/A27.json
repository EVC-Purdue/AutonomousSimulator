{
 "notes": "A27 stack: the sim stands in for the sensor and actuator drivers at the topic level, clocks each node, and samples SLAM and 3DGS poses",
 "label": "A27",
 "repo_env": "A27_REPO",
 "ros_distro": "jazzy",
 "image": "evc-sim:jazzy",
 "interface": "topic",
 "launch": "bringup_simdev.launch.py",
 "launch_args": {},
 "sim_support": "src/autonomous_kart/autonomous_kart/launch/bringup_simdev.launch.py",
 "nodes": ["master_node", "localization_node", "pathfinder_node"],
 "master_node": "master_node",
 "state_path": "/state",
 "frequency_param": "system_frequency_hz",
 "gps_heading_source": "dual",
 "sampled_sensors": ["slam", "gs3d"],
 "subscribers": {"/sim/clock/pathfinder_node": "pathfinder_node", "/sim/clock/localization_node": "localization_node",
                 "/system_state": "pathfinder_node", "/odom": "pathfinder_node",
                 "/gps": "localization_node", "/imu/front": "localization_node", "/imu/back": "localization_node",
                 "/e_comms/telemetry": "localization_node", "/slam/pose": "localization_node",
                 "/perception/measurements": "localization_node"},
 "warmup_s": 1.0,
 "bag_topics": ["cmd_drive", "mechanical_brake/command", "odom", "gps", "imu/front", "imu/back", "e_comms/telemetry",
                "slam/pose", "gs3d/pose", "perception/measurements", "system_state"]
}
