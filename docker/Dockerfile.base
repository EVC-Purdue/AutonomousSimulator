# ROS 2 Humble, the stack's Python deps, and PyChrono 10.0.0 built for Python 3.10
FROM ros:humble-ros-base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build git \
    libeigen3-dev swig python3-dev python3-pip python3-numpy socat can-utils procps \
    ros-humble-nav-msgs ros-humble-sensor-msgs ros-humble-tf2-ros ros-humble-rosbag2-storage-mcap \
    python3-colcon-common-extensions && rm -rf /var/lib/apt/lists/*
COPY requirements-stack.txt /tmp/
RUN pip3 install --no-cache-dir -r /tmp/requirements-stack.txt
COPY build_chrono.sh /tmp/
RUN bash /tmp/build_chrono.sh
ENV PYTHONPATH=/usr/local/lib/python3.10/dist-packages
