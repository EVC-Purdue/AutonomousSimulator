# ROS 2 (Humble for A26, Jazzy for A27), the stack's Python deps, and PyChrono 10.0.0 built for the distro's Python
ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
ARG PY=3.10
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build git \
    libeigen3-dev swig python3-dev python3-pip python3-numpy socat can-utils procps \
    ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-rosbag2-storage-mcap \
    python3-colcon-common-extensions && rm -rf /var/lib/apt/lists/*
COPY requirements-stack.txt /tmp/
RUN PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install --no-cache-dir -r /tmp/requirements-stack.txt
COPY build_chrono.sh /tmp/
RUN PY=${PY} bash /tmp/build_chrono.sh
ENV PYTHONPATH=/usr/local/lib/python${PY}/dist-packages
