Bootstrap: docker
From: ros:humble-ros-base

# Apptainer twin of docker/Dockerfile.base for Gautschi: Chrono comes prebuilt (x86-64, CH_USE_SIMD=OFF) as chrono.tgz,
# the /usr/local install of build_chrono.sh exported from the Modal image; the harness dirs are bound at /opt/sim at run time
# %files go to /opt/build, not /tmp: the build binds the host /tmp over it during %post
%files
    requirements-stack.txt /opt/build/requirements-stack.txt
    chrono.tgz /opt/build/chrono.tgz

%environment
    export PYTHONPATH=/opt/sim:/usr/local/lib/python3.10/dist-packages

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build git \
        libeigen3-dev swig python3-dev python3-pip python3-numpy socat can-utils procps \
        ros-humble-nav-msgs ros-humble-sensor-msgs ros-humble-tf2-ros ros-humble-rosbag2-storage-mcap \
        python3-colcon-common-extensions && rm -rf /var/lib/apt/lists/*
    pip3 install --no-cache-dir -r /opt/build/requirements-stack.txt
    tar xzf /opt/build/chrono.tgz -C / && rm -r /opt/build && ldconfig
    python3 -c "import pychrono, pychrono.vehicle; print('pychrono ok', pychrono.__file__)"
    mkdir -p /opt/sim /ws /out
